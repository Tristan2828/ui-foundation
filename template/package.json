{
  "name": "ui-foundation-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:real": "tsc -b && vite build --mode real",
    "preview": "vite preview",
    "lint": "eslint .",
    "gen:api": "openapi-typescript ./openapi.yaml -o ./src/api/schema.d.ts",
    "sync:foundation": "ui-foundation sync",
    "verify:fast": "npm run gen:api && git diff --exit-code -- src/api/schema.d.ts && ui-foundation sync --check && ui-foundation check-contract && ui-foundation check-deps && tsc -b && eslint . --max-warnings 0 && vitest run",
    "verify": "npm run verify:fast && playwright test",
    "verify:backend": "bash backend/scripts/verify.sh"
  },
  "dependencies": {
    "@tristan2828/ui-foundation": "^3.0.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^9.2.4",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.103.1",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.2",
    "msw": "^2.15.0",
    "openapi-response-validator": "^12.1.3",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
