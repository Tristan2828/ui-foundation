# Database — Supabase by default (see docs/cloud-postgres.md for the full
# walkthrough). Fill in your project ref, password and region, and download
# Supabase's root CA to the path below. Shape below is Supabase's; any
# SSL-requiring managed Postgres works the same way.
#
# This is the pooler host on its *session-mode* port (5432, not the default
# transaction-mode 6543) — session mode still supports the prepared
# statements Alembic's migration DDL needs. Supabase's own "direct
# connection" hostname (db.<ref>.supabase.co) only resolves over IPv6 unless
# you pay for their IPv4 add-on, so the pooler is the IPv4-reachable option.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Supabase's Postgres TLS cert chains to their own private root CA, not a
# publicly-trusted one (unlike their HTTPS/dashboard endpoints) — verifying
# it needs that CA file. backend/certs/ is gitignored.
DATABASE_SSL_CA_FILE=./certs/supabase-root-ca.pem

# Offline / local alternative: the docker-compose.yml Postgres. Swap these in
# for the three lines above (or run `bash backend/scripts/dev.sh --local`,
# which forces this without editing .env). scripts/check-phase-8.sh always
# uses this local database, whatever is set here.
# DATABASE_URL=postgresql+asyncpg://ui_foundation:ui_foundation@localhost:5432/ui_foundation
# DATABASE_SSL=false

# Phase 10 (auth) — see docs/BUILD-PLAN.md. Defaults below match a real
# deployment must change: SEED_USER_PASSWORD in particular, and
# COOKIE_SECURE=true once served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=dev-password-123
