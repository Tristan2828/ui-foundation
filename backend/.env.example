DATABASE_URL=postgresql+asyncpg://ui_foundation:ui_foundation@localhost:5432/ui_foundation

# Phase 10 (auth) — see docs/BUILD-PLAN.md. Defaults below match a real
# deployment must change: SEED_USER_PASSWORD in particular, and
# COOKIE_SECURE=true once served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=dev-password-123

# Cloud Postgres (Phase 12) — see docs/cloud-postgres.md. Uncomment to point
# at a hosted instance instead of the local docker-compose.yml Postgres.
# Shape below is Supabase's; any SSL-requiring managed Postgres works the
# same way. This is the pooler host on its *session-mode* port (5432, not
# the default transaction-mode 6543) — session mode still supports the
# prepared statements Alembic's migration DDL needs. Supabase's own
# "direct connection" hostname (db.<ref>.supabase.co) only resolves over
# IPv6 unless you pay for their IPv4 add-on, so the pooler is the
# IPv4-reachable option in practice — see docs/cloud-postgres.md.
# DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# Supabase's Postgres TLS cert chains to their own private root CA, not a
# publicly-trusted one (unlike their HTTPS/dashboard endpoints) — verifying
# it needs that CA file. See docs/cloud-postgres.md for how to get it.
# DATABASE_SSL_CA_FILE=./certs/supabase-root-ca.pem
