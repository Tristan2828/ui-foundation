{
  // What `npm run build` emits into dist/: JavaScript plus declarations,
  // without the stories or the story/test fixtures. scripts/build.mjs then rewrites the `@/` alias
  // and adds file extensions, since tsc leaves specifiers as written.
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": null
  },
  "exclude": ["src/**/*.stories.tsx", "src/**/*.fixtures.ts"]
}
